{
  "name": "paytag",
  "version": "0.1.0",
  "description": "Username-to-wallet identity layer for multi-chain crypto payments",
  "main": "dist/index.js",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "abis": "node scripts/export-abis.mjs",
    "abis:check": "node scripts/export-abis.mjs --check",
    "sdk:build": "npm run build -w @paytagdev/sdk",
    "sdk:test": "npm test -w @paytagdev/sdk",
    "web:dev": "npm run sdk:build && npm run dev -w paytag-web",
    "web:build": "npm run build -w paytag-web"
  },
  "dependencies": {
    "@scure/base": "^1.2.6",
    "@supabase/supabase-js": "^2.45.0",
    "bech32": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  }
}
